{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compass-framework.example/schemas/resume-release/artifact-name-integrity-receipt.schema.json",
  "title": "COMPASS Artifact Name Integrity Receipt",
  "description": "Observed artifact names across creation, publication, attachment, presentation, download, archive, manifest, and metadata surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "canonical_filename", "observations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "canonical_filename": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "status"],
        "properties": {
          "surface": {
            "enum": [
              "staged_filesystem_filename",
              "final_filesystem_filename",
              "published_object_name",
              "attachment_name",
              "browser_download_filename",
              "content_disposition_filename",
              "storage_display_name",
              "markdown_link_label",
              "user_visible_link_text",
              "user_visible_link_target",
              "completion_message_artifact_name",
              "manifest_filename_field",
              "manifest_path_field",
              "zip_filename",
              "zip_entry_name",
              "generated_metadata_name",
              "copied_variant_name"
            ]
          },
          "status": { "enum": ["observed", "not_applicable", "uninspectable"] },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "transport_encoding_required": { "type": "boolean", "default": false }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
            "then": { "required": ["expected", "actual"] }
          }
        ]
      }
    }
  }
}
